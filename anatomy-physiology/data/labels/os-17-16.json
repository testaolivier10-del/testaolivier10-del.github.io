    {
      "id": "pth-inhibits-osteoblasts",
      "name": "Inhibits osteoblasts",
      "accept": [
        "inhibits osteoblasts"
      ],
      "lines": [
        25
      ],
      "concept": "pth",
      "cover": true,
      "note": "OpenStax prints 'Inhibits osteoblasts' as an effect of PTH on bone. PTH acts on osteoblasts, which carry its receptor, and they respond by signaling osteoclasts to form and work harder; PTH does not simply inhibit them (short pulses of PTH even build bone). Covered for good and never asked; the notes and caption explain the osteoblast route.",
      "box": [
        60,
        891,
        173,
        19
      ]
    },
    {
      "id": "pth-stimulates-osteoclasts",
      "name": "Stimulates osteoclasts",
      "accept": [
        "stimulates osteoclasts"
      ],
      "lines": [
        28
      ],
      "concept": "pth",
      "cover": true,
      "note": "OpenStax prints 'Stimulates osteoclasts' as a direct effect of PTH. Osteoclasts have no PTH receptor; PTH reaches them only through the osteoblasts. Printed beside the wrong 'Inhibits osteoblasts', the pair teaches a direct two-cell effect that is not what happens, so both are covered for good and never asked. The line below them ('Bone is broken down, releasing calcium ions into bloodstream') still shows the net effect.",
      "box": [
        60,
        912,
        198,
        19
      ]
    },
