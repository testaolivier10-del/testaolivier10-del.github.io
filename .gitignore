.DS_Store
Thumbs.db
node_modules/
*.log
.vscode/
.idea/
# One-off browser harnesses used to drive a lesson end to end or prove a
# refactor (Playwright lives in node_modules at the repo root, so these have to
# sit here to resolve their imports). Two of them were committed by accident
# with `git add -A` while a background run still had its file on disk.
drive*.mjs
splittest.mjs
renum.mjs
node_modules
.cache/
.serena/*
!.serena/memories/

# Python wheels a browser-test setup can drop in the repo root
*.whl
.claude/worktrees/

# Secrets and local tool state that must never be committed (site audit
# 2026-10): wrangler's local cache and dev vars, env files, private keys.
.wrangler/
.dev.vars
.env*
*.pem
