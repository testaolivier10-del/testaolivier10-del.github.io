 "parts": [
  {
   "label": "a",
   "points": 1,
   "prompt": "<b>Identify</b> the limiting reactant. <b>Justify</b> your answer using the diagram.",
   "rubric": [
    {
     "point": "Identifies H₂ as limiting, with a justification: 6 H₂ react with only 2 N₂ (ratio 3 : 1), so H₂ runs out while 1 N₂ is left (or: 3 N₂ would need 9 H₂).",
     "accept": [
      "H₂, because 3 N₂ need 9 H₂ but only 6 are present"
     ]
    }
   ],
   "sample": "H₂ is limiting. Each N₂ needs three H₂, so the 3 N₂ would need 9 H₂, but only 6 H₂ are present. The 6 H₂ react with 2 N₂ and are used up, leaving 1 N₂."
  },
  {
   "label": "b",
   "points": 1,
   "prompt": "<b>Draw</b> (or describe precisely) the contents of the box after the reaction is complete, using the same key.",
   "rubric": [
    {
     "point": "Shows 4 NH₃ molecules (one N bonded to three H) and 1 N₂ molecule, and nothing else; 6 N atoms and 12 H atoms in total.",
     "accept": [
      "four ammonia molecules and one leftover N₂"
     ]
    }
   ],
   "sample": "The box holds four NH₃ molecules, each drawn as one N atom bonded to three H atoms, and one N₂ molecule left over. Check: 4 + 2 = 6 N atoms and 12 H atoms, as before."
  },
  {
   "label": "c",
   "points": 2,
   "prompt": "In a real reactor, 56.0 g of N₂ (28.02 g/mol) reacts with 9.00 g of H₂ (2.016 g/mol). <b>Calculate</b> the theoretical yield of NH₃ (17.03 g/mol) in grams.",
   "rubric": [
    {
     "point": "Finds moles and the limiting reactant: N₂ 1.999 mol (could make 3.997 mol NH₃); H₂ 4.464 mol (could make 2.976 mol NH₃), so H₂ is limiting.",
     "accept": [
      "H₂ limiting, 2.976 mol NH₃"
     ]
    },
    {
     "point": "Theoretical yield 2.976 mol × 17.03 g/mol = 50.7 g NH₃.",
     "accept": [
      "50.7 g"
     ]
    }
   ],
   "sample": "N₂: 56.0 g ÷ 28.02 g/mol = 1.999 mol, enough for 2 × 1.999 = 3.997 mol NH₃. H₂: 9.00 g ÷ 2.016 g/mol = 4.464 mol, enough for 4.464 × 2/3 = 2.976 mol NH₃. H₂ makes less, so it is limiting. Theoretical yield = 2.976 mol × 17.03 g/mol = 50.7 g NH₃."
  }
 ]
