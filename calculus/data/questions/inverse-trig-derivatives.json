   "practice": "1.E",
   "level": "apply",
   "diff": 2,
   "q": "Find $f'(x)$ for the function in the graph, $f(x) = \\arctan(2x)$.",
   "stimulus": "inverse-trig-derivatives-s1",
   "expr": {
    "answer": "2/(1 + 4x^2)",
    "vars": [
     "x"
    ],
    "lhs": "f'(x) =",
    "mistakes": [
     {
      "expr": "1/(1 + 4x^2)",
      "why": "The inside function $2x$ has derivative 2; the chain rule multiplies by it."
     },
     {
      "expr": "2/(1 + 2x^2)",
      "why": "Square the whole inside function: $(2x)^2 = 4x^2$, not $2x^2$."
     }
    ]
   },
   "why": {
    "correct": "$\\frac{d}{dx}\\arctan u = \\frac{1}{1 + u^2} \\cdot u'$ with $u = 2x$: $\\frac{1}{1 + (2x)^2} \\cdot 2 = \\frac{2}{1 + 4x^2}$."
   }
  },
  {
   "id": "calc-inverse-trig-derivatives-2",
   "unit": "unit-3",
   "topic": "inverse-trig-derivatives",
   "type": "numeric",
   "practice": "1.E",
   "level": "apply",
   "diff": 1,
   "q": "What is the slope of the graph of $f$ at the origin?",
   "stimulus": "inverse-trig-derivatives-s1",
   "numeric": {
    "answer": 2,
    "mistakes": [
     {
      "value": 1,
      "why": "That is the slope of $\\arctan x$ at 0. The inside function $2x$ doubles it."
     }
    ]
   },
   "why": {
    "correct": "$f'(0) = \\frac{2}{1 + 0} = 2$. The graph is steepest at the origin."
   }
  },
