   "diff": 2,
   "q": "Using the table, find the derivative of the composite function $h(x) = \\arcsin(g(x))$ at $x = 1$.",
   "stimulus": "inverse-trig-derivatives-s2",
   "numeric": {
    "answer": "2*sqrt(3)",
    "mistakes": [
     {
      "value": "2/sqrt(3)",
      "why": "That is $\\frac{1}{\\sqrt{1 - \\frac{1}{4}}}$ with no inside derivative. Multiply by $g'(1) = 3$."
     },
     {
      "value": "3*sqrt(2)",
      "why": "Square the inside value: $1 - \\left(\\frac{1}{2}\\right)^2 = \\frac{3}{4}$, not $1 - \\frac{1}{2}$."
     }
    ]
   },
   "why": {
    "correct": "$h'(x) = \\frac{g'(x)}{\\sqrt{1 - [g(x)]^2}}$, so $h'(1) = \\frac{3}{\\sqrt{1 - \\frac{1}{4}}} = \\frac{3}{\\frac{\\sqrt{3}}{2}} = 2\\sqrt{3}$."
   }
  },
