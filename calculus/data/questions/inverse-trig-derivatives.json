    ],
    "lhs": "\\frac{d}{dx}\\arcsin(x^2) =",
    "mistakes": [
     {
      "expr": "1/sqrt(1 - x^4)",
      "why": "Multiply by the derivative of the inside function $x^2$, which is $2x$."
     },
     {
      "expr": "2x/sqrt(1 - x^2)",
      "why": "The square in the formula applies to the whole inside: $(x^2)^2 = x^4$."
     }
    ]
   },
   "why": {
    "correct": "$\\frac{1}{\\sqrt{1 - (x^2)^2}} \\cdot 2x = \\frac{2x}{\\sqrt{1 - x^4}}$."
