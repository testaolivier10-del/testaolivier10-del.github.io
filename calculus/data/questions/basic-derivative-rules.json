   "stimulus": "basic-derivative-rules-s1",
   "q": "Find $f'(2)$.",
   "numeric": {
    "answer": -3,
    "mistakes": [
     {
      "value": 3,
      "why": "That is $f(2) = 8 - 24 + 18 + 1$, the height. The slope is $f'(2) = 3(4) - 12(2) + 9$."
     },
     {
      "value": -2,
      "why": "The constant 1 was kept in the derivative; its derivative is 0."
     }
    ]
   },
   "why": {
    "correct": "$f'(2) = 3(2)^2 - 12(2) + 9 = 12 - 24 + 9 = -3$. The graph falls at $x = 2$."
   }
  },
  {
   "id": "calc-basic-derivative-rules-3",
