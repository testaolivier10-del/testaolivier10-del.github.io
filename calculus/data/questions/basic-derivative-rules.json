   "stimulus": "basic-derivative-rules-s1",
   "q": "Find $f'(x)$ for $f(x) = x^3 - 6x^2 + 9x + 1$.",
   "expr": {
    "answer": "3x^2 - 12x + 9",
    "vars": [
     "x"
    ],
    "lhs": "f'(x) =",
    "mistakes": [
     {
      "expr": "3x^2 - 12x + 10",
      "why": "The constant term 1 has derivative 0; it does not combine with the 9."
     },
     {
      "expr": "3x^2 - 6x + 9",
      "why": "$\\frac{d}{dx}\\left( 6x^2 \\right) = 6 \\cdot 2x = 12x$: keep the constant factor and bring the exponent down."
     },
     {
      "expr": "3x^2 - 12x",
      "why": "$\\frac{d}{dx}(9x) = 9$, not 0. Only the constant term disappears."
     }
    ]
   },
   "why": {
    "correct": "Term by term: $3x^2 - 6(2x) + 9(1) + 0 = 3x^2 - 12x + 9$."
   }
  },
  {
   "id": "calc-basic-derivative-rules-2",
   "unit": "unit-2",
