   "q": "Let $h(x) = 3f(x) - 2g(x)$. Find $h'(2)$.",
   "numeric": {
    "answer": -11,
    "mistakes": [
     {
      "value": -1,
      "why": "That is $h(2) = 3(3) - 2(5)$, built from the values. Use the derivative columns: $3f'(2) - 2g'(2)$."
     },
     {
      "value": 5,
      "why": "The minus sign applies to the whole $2g'(2)$: $3(-1) - 2(4) = -3 - 8$."
     },
     {
      "value": -5,
      "why": "Keep the constant factors: $(3f)' = 3f'$ and $(2g)' = 2g'$, so $3(-1) - 2(4)$."
     }
    ]
   },
   "why": {
    "correct": "$h'(2) = 3f'(2) - 2g'(2) = 3(-1) - 2(4) = -11$."
   }
  },
