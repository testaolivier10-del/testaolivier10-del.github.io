    "answer": 30000,
    "tol": 1000,
    "unit": "W",
    "sigfigs": 2,
    "mistakes": [
     {
      "value": 3000,
      "why": "Value: that is mv/t, a force, not a power. Find ΔK = ½mv² first, then divide by the time."
     }
