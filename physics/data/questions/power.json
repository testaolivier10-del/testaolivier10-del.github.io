   "stimulus": "power-s1",
   "q": "How much work does winch X's cable do on its crate during the lift? Give the value and its unit.",
   "numeric": {
    "answer": 1180,
    "tol": 10,
    "unit": "J",
    "askUnit": true,
    "sigfigs": 3,
    "mistakes": [
     {
      "value": 120,
      "why": "Value: that multiplies mass by height. Work is force times distance: the cable's force is mg = 392 N."
     }
    ]
   },
   "why": {
    "correct": "At constant speed the cable's force equals mg = (40.0 kg)(9.8 m/s²) = 392 N, so W = (392 N)(3.00 m) = 1.18 × 10³ J."
   }
  },
  {
   "id": "phys-power-2",
   "type": "numeric",
   "unit": "unit-3",
   "topic": "power",
   "practice": "2.B",
   "level": "apply",
