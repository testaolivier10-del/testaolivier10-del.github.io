   "stimulus": "power-s1",
   "q": "What is winch X's average power output to its crate? Give the value and its unit.",
   "numeric": {
    "answer": 196,
    "tol": 1,
    "unit": "W",
    "askUnit": true,
    "sigfigs": 3,
    "mistakes": [
     {
      "value": 7060,
      "why": "Value: power is work divided by time, not multiplied."
     },
     {
      "value": 98,
      "why": "Value: 12.0 s is winch Y's time. Winch X takes 6.00 s."
     }
    ]
   },
   "why": {
    "correct": "P = W/Δt = 1176 J / 6.00 s = 196 W. A watt is a joule per second."
   }
